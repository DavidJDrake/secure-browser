#!/usr/bin/env bash
# Playwright MCP server, running as the secrets user.
#
# Claude Code spawns this through the sudoers rule and talks to it over stdio.
# Because the process runs as the secrets user, the browser profile and its
# cookies live in that user's home at mode 700 - usable by the agent driving the
# browser, unreadable by the account the agent itself runs as.
#
# Anything written for the caller (screenshots, downloads, traces) goes to the
# shared exchange directory, which is the only path both users can touch.
set -euo pipefail

PROFILE="${SECURE_BROWSER_PROFILE:-$HOME/.browser-profile}"
EXCHANGE="${SECURE_BROWSER_EXCHANGE:-/srv/secure-browser-exchange}"

mkdir -p "$PROFILE"; chmod 700 "$PROFILE"

# WSLg: the caller's display, granted to this user by install.sh via xhost.
export DISPLAY="${DISPLAY:-:0}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/mnt/wslg/runtime-dir}"

# Claude Code spawns this with the CALLER's project directory as cwd, which this
# user cannot enter (caller's home is 750). npx then fails with EACCES on
# 'spawn sh'. Move somewhere this user can actually stand before exec.
#
# The exchange, not $HOME: the server treats its cwd as the workspace root,
# and browser_file_upload will attach any file under that root. With $HOME as
# the root the service-account token would be uploadable to any site.
cd "$EXCHANGE"

# @playwright/mcp needs Node 20+. sudo resets PATH to secure_path, so the
# caller's nvm node is invisible here; a system-wide Node 20+ is required.
NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
if [ "$NODE_MAJOR" -lt 20 ]; then
  echo "secure-browser mcp-server: node $(node -v 2>/dev/null || echo missing) on PATH for $(id -un); @playwright/mcp needs Node 20+. Install a system-wide Node 20+ (e.g. NodeSource) and re-run setup/install.sh." >&2
  exit 1
fi

# Everything this process executes comes from the root-owned install
# directory: the installer ran `npm ci` there from the committed lockfile, so
# both the Playwright server and the tool-filter proxy are pinned by content
# hash and are not writable by this user or the caller. No npx at runtime: an
# npx cache lives in this user's home, which this user can write.
INSTALL="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GATE="$INSTALL/node_modules/mcp-tool-gate/bin/mcp-tool-gate.js"
SERVER="$INSTALL/node_modules/@playwright/mcp/cli.js"
for f in "$GATE" "$SERVER"; do
  [ -f "$f" ] || { echo "secure-browser mcp-server: missing $f - re-run setup/install.sh (it runs npm ci into $INSTALL)" >&2; exit 1; }
done

# Session handoff. The login helper signs in with Playwright-Python and saves a
# storage-state JSON. A persistent --user-data-dir profile never reads that
# file, so the two would be separate browsers and a login here would never
# reach the agent. Run isolated and seed the context from the helper's file
# instead; the helper rewrites it on every successful run. The file is only
# read at startup, so a login done mid-session needs a new Claude Code session.
STATE="$PROFILE/storage-state.json"
STATE_ARGS=()
if [ -s "$STATE" ]; then
  STATE_ARGS=(--storage-state "$STATE")
else
  echo "secure-browser mcp-server: no saved session at $STATE - run 'secure-browser login <site>' then start a new session" >&2
fi

# stdout is the MCP channel - it must carry protocol frames and nothing else.
# Send every diagnostic to stderr.
#
# Tool filter. The stock server ships browser_run_code_unsafe, which runs Node
# code inside this process, i.e. as the secrets user, and could read the token
# or dump the cookie jar. No server flag removes a core tool, so mcp-tool-gate
# sits in front of it as a stdio proxy: it hides the tool from tools/list and
# refuses calls to it. Refusals are logged to this user's home.
DENY="${SECURE_BROWSER_DENY_TOOLS:-browser_run_code_unsafe}"
exec node "$GATE" --deny "$DENY" --log "$HOME/mcp-filter.log" -- \
  node "$SERVER" \
  --isolated \
  "${STATE_ARGS[@]}" \
  --output-dir "$EXCHANGE" \
  "$@"
